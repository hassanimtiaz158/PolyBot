# ── Operating Mode ──────────────────────────────────────────────────
# RESEARCH | BACKTEST | PAPER | LIVE_GUARDED | HALTED
MODE=RESEARCH

# ── Polymarket API Credentials (optional — empty for research/demo) ─
POLY_API_KEY=
POLY_SECRET=
POLY_PASSPHRASE=

# ── Polymarket Wallet (required only for LIVE_GUARDED order signing) ─
# Private key that signs order EIP-712 payloads. NEVER commit a real
# value. Leave empty outside of live trading.
POLY_PRIVATE_KEY=
# Funder/proxy wallet address holding trading funds (only needed if
# POLY_SIGNATURE_TYPE != 0).
POLY_FUNDER_ADDRESS=
# EOA=0, POLY_PROXY (email/Magic wallet)=1, POLY_GNOSIS_SAFE (browser proxy)=2
POLY_SIGNATURE_TYPE=0

# ── Emergency Control Key (required for writable control endpoints) ─
# Dedicated secret for /api/control/* (kill switch + resume).  Must be
# set to enable the control interface; when empty the endpoints return
# 503 (disabled) and can never be used to stop the bot.
POLY_CONTROL_KEY=

# ── Database ────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///data/polymarket.db

# ── Portfolio / account ─────────────────────────────────────────────
# Starting equity used by the API to derive account balance from P&L.
INITIAL_EQUITY=10000

# ── Logging ─────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=structured

# ── Risk Limits (conservative defaults) ─────────────────────────────
MAX_POSITION_PCT=0.01
MAX_MARKET_EXPOSURE_PCT=0.02
MAX_TOTAL_EXPOSURE_PCT=0.05
MAX_DAILY_LOSS_PCT=0.02
MAX_CONSECUTIVE_LOSSES=5
MAX_OPEN_POSITIONS=10
MAX_SPREAD=0.03
MIN_LIQUIDITY=1000.0
MIN_NET_EDGE=0.05
MIN_CONFIDENCE=0.70
DATA_MAX_AGE_SECONDS=5

# ── Data Collection ─────────────────────────────────────────────────
MARKET_SCAN_INTERVAL_SECONDS=300

# ── Monitoring ──────────────────────────────────────────────────────
HEALTH_CHECK_INTERVAL_SECONDS=30

# ── Alerting (optional adapter) ─────────────────────────────────────
# Set to true to enable operator alerts.  Alerts never contain
# credentials, API keys, or private keys.
ALERT_ENABLED=false
# Optional webhook URL (e.g. Slack/Telegram bot endpoint) for alerts.
ALERT_WEBHOOK_URL=
# Minimum seconds between identical alerts (de-duping).
ALERT_MIN_INTERVAL_SECONDS=60
# Escalate when the same alert repeats this many times within the window.
ALERT_REPEAT_THRESHOLD=5
ALERT_REPEAT_WINDOW_SECONDS=300

# ── Dashboard (read-only Streamlit UI) ─────────────────────────────
# Set to true to show the dashboard with fabricated sample data (no API calls).
DASHBOARD_DEMO=true
# URL of the read-only FastAPI backend (http://api:8000 inside docker-compose).
DASHBOARD_API_URL=http://localhost:8000
# Starting equity used by the dashboard to estimate total equity from P&L.
DASHBOARD_EQUITY_BASE=10000

# ── API Security ────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins.  Empty = same-origin only.
# Example: "https://dashboard.example.com,https://admin.example.com"
CORS_ALLOW_ORIGINS=
